# Line endings: LF in the repo and in every checkout, on Windows, WSL2 and Linux alike.
# Git detects text files itself; the lists below make the important cases explicit.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert, never diff as text
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.zip  binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.docx binary
*.pptx binary
*.xlsx binary
