  \node[anchor=south west,inner sep=0pt] at \kwo{24}{174.5} {\includegraphics[width=30mm]{\kwasset{\kwfootlogo}}};
  \node[anchor=base east,inner sep=0pt,text=\kwnumc] at \kwo{314.67}{174.2} {\kwregular\kwsize{12}{14}\insertframenumber};}\fi}

% ---------- Frame wrapper ----------
