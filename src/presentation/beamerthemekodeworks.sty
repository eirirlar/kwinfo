% ---------- 5. Columns / comparison ----------
% \kwcol{index}{count}{y}{heading or empty}{body}: all columns share one size (20 pt, or 18 pt if any is too tall)
\newcommand{\kwcolgeom}[2]{%
  \pgfmathsetmacro{\kwcolw}{(\kwcw-16*(#2-1))/#2}%
  \pgfmathsetmacro{\kwcolx}{24+(#1-1)*(\kwcolw+16)}}
\newcommand{\kwcoloff}[1]{\kwifempty{#1}{\def\kwoff{0}}{\def\kwoff{17}}}
\newcommand{\kwbodyblk}[1]{\kwbody #1\par}
\newcommand{\kwcolmeasure}[5]{%
  \kwcolgeom{#1}{#2}\kwcoloff{#4}\pgfmathsetmacro{\kwmx}{164-(#3)-\kwoff}%
  \kwmeasure{\kwcolw}{\kwbodyblk{#5}}\ifdim\kwh>\kwmx mm \global\kwsmalltrue\fi}
\newcommand{\kwcoldraw}[5]{%
  \kwcolgeom{#1}{#2}\kwcoloff{#4}\pgfmathsetmacro{\kwmx}{164-(#3)-\kwoff}%
  \kwifempty{#4}{}{%
    \kwdraw{\draw[line width=0.6pt,color=kwblack] \kwo{\kwcolx}{#3} -- ++(\kwcolw mm,0);}%
    \kwat{\kwcolx}{(#3)+5}{\kwcolw}{\color{kwblack}\kwlabel{#4}}}%
  \kwmeasure{\kwcolw}{\kwbodyblk{#5}}%
  \pgfmathsetmacro{\kwby}{(#3)+\kwoff}%
  \kwscaledraw{\kwcolx}{\kwby}{\kwmx}}
\let\kwcol\kwcoldraw
\newcommand{\kwcolumns}[4]{\kwframe{kwwhite}{kw-navnetrekk-svart.pdf}{kwmuted}{kwdarkgreen}{%
  \kwtab
  \kwat{24}{23}{250}{\kwtitle #1}%
  \gdef\kwcurtitle{#1}%
  \kwifempty{#2}{\def\kwcy{58}}{\kwat{24}{58}{230}{\kwlead #2}\def\kwcy{92}}%
  \global\kwsmallfalse
  \begingroup\let\kwcol\kwcolmeasure #3\endgroup
  \let\kwcol\kwcoldraw #3}{#4}}

