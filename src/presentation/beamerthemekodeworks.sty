% ---------- Absolute placement helpers (mm from the page's top-left corner) ----------
\makeatletter
\newcommand{\kwo}[2]{($(current page.north west)+({(#1)*1mm},{-(#2)*1mm})$)}
\newcommand{\kwdraw}[1]{\ifvmode\nointerlineskip\fi\vbox to 0pt{\hbox to 0pt{%
  \begin{tikzpicture}[remember picture,overlay] #1 \end{tikzpicture}\hss}\vss}\ifvmode\nointerlineskip\fi}
% \kwat{x}{y}{width}{content}: text block, top-left anchored, fixed width
\newcommand{\kwat}[4]{\kwdraw{\node[anchor=north west,inner sep=0pt,align=left,text width=#3mm] at \kwo{#1}{#2} {#4\par};}}
% \kwatb{x}{y}{width}{content}: same, but anchored at its bottom-left corner
\newcommand{\kwatb}[4]{\kwdraw{\node[anchor=south west,inner sep=0pt,align=left,text width=#3mm] at \kwo{#1}{#2} {#4\par};}}
\newcommand{\kwrect}[5]{\kwdraw{\fill[fill=#5] \kwo{#1}{#2} rectangle ++(#3mm,-#4mm);}}
\newcommand{\kwasset}[1]{\kwassetdir/#1}
% \kwimg{x}{y}{width mm}{asset}: asset graphic, top-left anchored
\newcommand{\kwimg}[4]{\kwdraw{\node[anchor=north west,inner sep=0pt] at \kwo{#1}{#2} {\includegraphics[width=#3mm]{\kwasset{#4}}};}}
% \kwseismo{x}{y}{width mm}: green motif, clipped to the page (it bleeds off the edges)
\newcommand{\kwseismo}[3]{\kwdraw{\begin{scope}
  \clip (current page.north west) rectangle (current page.south east);
  \node[anchor=north west,inner sep=0pt] at \kwo{#1}{#2} {\includegraphics[width=#3mm]{\kwasset{femte-element-gronn.pdf}}};
  \end{scope}}}
% \kwcover{x}{y}{W}{H}{file}: photo cropped to fill the box (document-relative path via \graphicspath)
\newsavebox{\kwbox}
\newcommand{\kwcover}[5]{\sbox{\kwbox}{\includegraphics{#5}}%
  \pgfmathsetmacro{\kwar}{\strip@pt\wd\kwbox/\strip@pt\ht\kwbox}%
  \pgfmathtruncatemacro{\kwwide}{\kwar > (#3)/(#4) ? 1 : 0}%
  \kwdraw{\begin{scope}
    \clip \kwo{#1}{#2} rectangle ++(#3mm,-#4mm);
    \ifnum\kwwide=1
      \node[inner sep=0pt] at ($(current page.north west)+(#1mm+0.5*#3mm,-#2mm-0.5*#4mm)$) {\includegraphics[height=#4mm]{#5}};
    \else
      \node[inner sep=0pt] at ($(current page.north west)+(#1mm+0.5*#3mm,-#2mm-0.5*#4mm)$) {\includegraphics[width=#3mm]{#5}};
    \fi
  \end{scope}}}
% \kwfit{max width mm}{size pt}{text}: Light text at the given size, scaled down to fit the width
\newcommand{\kwfit}[3]{\sbox{\kwbox}{\kwlight\kwsize{#2}{#2}#3}%
  \pgfmathsetmacro{\kwsz}{min(#2, #2*((#1)*2.84528*0.95/\strip@pt\wd\kwbox))}%
  \kwlight\kwsize{\kwsz}{\kwsz}#3}
\long\def\kwifempty#1#2#3{\def\kwtmp{#1}\ifx\kwtmp\@empty #2\else #3\fi}
\makeatother
\def\kwcw{290.67}% content width: 338.67 - 2 x 24

% ---------- Measuring and fitting (round 3) ----------
% Content slides are measured before they are drawn: 20 pt first, 18 pt (the minimum) if the text is too tall
% for the area above the footer, and if it is still too tall it is scaled down to fit and a package warning is issued.
\newsavebox{\kwmeas}
\newdimen\kwh \newdimen\kwavail \newdimen\kwmh \newdimen\kwsh
\newif\ifkwsmall
\makeatletter
\newcommand{\kwmeasure}[2]{\sbox{\kwmeas}{\begin{minipage}[t]{#1mm}\hfuzz=\maxdimen\vfuzz=\maxdimen\hbadness=10000 #2\end{minipage}}\kwh=\dimexpr\ht\kwmeas+\dp\kwmeas\relax}
\newcommand{\kwtoomuch}{\begingroup\renewcommand{\emph}[1]{##1}%
  \PackageWarning{kodeworks}{Too much text on slide «\kwcurtitle»: split it in two}\endgroup}
\gdef\kwcurtitle{}
% \kwscaledraw{x}{y}{max height mm}: draw the measured box (\kwmeas), scaled down if it is taller than the limit
\newcommand{\kwscaledraw}[3]{%
  \ifdim\kwh>#3mm \pgfmathsetmacro{\kwsc}{(#3)*2.84528/\strip@pt\kwh}\kwtoomuch\else\def\kwsc{1}\fi
  \kwdraw{\node[anchor=north west,inner sep=0pt] at \kwo{#1}{#2} {\scalebox{\kwsc}{\usebox{\kwmeas}}};}}
% \kwfitbody{x}{y}{width}{max height mm}{content}{wide width}: 20 pt, then 18 pt, then 18 pt in the wide column, then scaled
\newcommand{\kwfitbody}[6]{%
  \global\kwsmallfalse
  \kwmeasure{#3}{#5}%
  \ifdim\kwh>#4mm \global\kwsmalltrue \kwmeasure{#3}{#5}%
    \ifdim\kwh>#4mm \kwmeasure{#6}{#5}\fi\fi
  \kwscaledraw{#1}{#2}{#4}}
\makeatother

