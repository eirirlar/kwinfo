% ---------- 7. Key figures on grey tiles ----------
% \kwfig{index}{count}{y}{number}{explanation}
\newcommand{\kwfig}[5]{%
  \pgfmathsetmacro{\kwtw}{(\kwcw-8*(#2-1))/#2}%
  \pgfmathsetmacro{\kwtx}{24+(#1-1)*(\kwtw+8)}%
  \pgfmathsetmacro{\kwtn}{ifthenelse(#2>3,64,78)}%
  \kwrect{\kwtx}{#3}{\kwtw}{92}{kwgrey}%
  \kwrect{\kwtx}{#3}{\kwtw}{1.6}{kwgreen}%
  \pgfmathsetmacro{\kwtwi}{\kwtw-18}%
  \kwat{\kwtx+9}{#3+11}{\kwtwi}{\color{kwblack}\kwfit{\kwtwi}{\kwtn}{#4}}%
  \kwatb{\kwtx+9}{#3+92-9}{\kwtwi}{\kwregular\kwsize{19}{25}\color{kwblack}\raggedright #5}}
\newcommand{\kwfigures}[4]{\kwframe{kwwhite}{kw-navnetrekk-svart.pdf}{kwmuted}{kwdarkgreen}{%
  \kwtab
  \kwat{24}{23}{250}{\kwtitle #1}%
  \kwifempty{#2}{\def\kwcy{58}}{\kwat{24}{58}{230}{\kwlead #2}\def\kwcy{84}}%
  #3}{#4}}

% ---------- 8. Logo wall ----------
% \kwlogo{index}{y}{content}   (4 columns, tile 38 mm high)
\def\kwhp{10000}
\newcommand{\kwtilestyle}[3]{\hyphenpenalty=\kwhp\exhyphenpenalty=0\raggedright\kwregular\kwsize{#1}{#2}\color{kwblack}#3}
\newcommand{\kwtilemeasure}[3]{\kwmeasure{#1}{\kwtilestyle\kwts\kwtl{#2}\par}\pgfmathsetmacro{\kwlim}{2*\kwtl+2}\kwavail=\kwlim pt\relax
  \setbox0\hbox{\kwtilestyle\kwts\kwtl{#3}}%
  \ifdim\wd0>#1mm \kwbadtrue\else\ifdim\kwh>\kwavail \kwbadtrue\else\kwbadfalse\fi\fi}
% name tiles: 24 pt, 20 pt, 16 pt when the name needs more than two lines or its longest word does not fit;
% no hyphenation (a last resort at 16 pt only if the longest word still does not fit), line spacing 1.15
\newcommand{\kwtilefit}[3]{\def\kwhp{10000}%
  \def\kwts{24}\def\kwtl{27.6}\kwtilemeasure{#1}{#2}{#3}%
  \ifkwbad \def\kwts{20}\def\kwtl{23}\kwtilemeasure{#1}{#2}{#3}%
    \ifkwbad \def\kwts{16}\def\kwtl{18.4}\setbox0\hbox{\kwtilestyle\kwts\kwtl{#3}}\ifdim\wd0>#1mm \def\kwhp{100}\fi\fi\fi}
\newcommand{\kwlogogeom}[2]{%
  \pgfmathtruncatemacro{\kwlr}{int((#1-1)/4)}%
  \pgfmathtruncatemacro{\kwlc}{mod(#1-1,4)}%
  \pgfmathsetmacro{\kwlw}{(\kwcw-24)/4}%
  \pgfmathsetmacro{\kwliw}{\kwlw-14}%
  \pgfmathsetmacro{\kwlx}{24+\kwlc*(\kwlw+8)}%
  \pgfmathsetmacro{\kwly}{#2+\kwlr*40}}
% pass 1: find the one size that fits every name (all tiles share it); pass 2: draw
\newcommand{\kwlogomeasure}[4]{\kwlogogeom{#1}{#2}%
  \kwifempty{#4}{}{\kwtilefit{\kwliw}{#3}{#4}%
    \ifdim\kwts pt<\kwgts pt \global\let\kwgts\kwts \global\let\kwgtl\kwtl\fi
    \ifnum\kwhp<10000 \gdef\kwghp{100}\fi}}
\newcommand{\kwlogodraw}[4]{\kwlogogeom{#1}{#2}%
  \kwrect{\kwlx}{\kwly}{\kwlw}{32}{kwgrey}%
  \kwdraw{\node[anchor=north west,inner sep=0pt,text width=\kwliw mm,align=left]
    at ($(current page.north west)+(\kwlx mm+7mm,-\kwly mm-9mm)$) {\let\kwts\kwgts\let\kwtl\kwgtl\let\kwhp\kwghp\kwtilestyle\kwts\kwtl{#3}\par};}}
\let\kwlogo\kwlogodraw
