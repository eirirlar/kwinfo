\newcommand{\kwtab}{\kwrect{24}{0}{14}{3.4}{kwgreen}}

% ---------- 1. Title slide: title, subtitle and meta flow in one block anchored to a fixed bottom line ----------
\newcommand{\kwtitlebigs}[3]{{\kwnohyph\kwlight\kwsize{#1}{#2}\color{kwwhite}#3\par}}
% \kwtitlesize{width}{available height (dimen)}{title}: 58 pt, then 44 pt, then 36 pt; sets \kwts and \kwtl
\newif\ifkwbad
\newdimen\kwtav \newdimen\kwtlim
\newcommand{\kwtitletry}[4]{\def\kwts{#1}\def\kwtl{#2}\kwmeasure{#3}{\kwtitlebigs\kwts\kwtl{#4}}%
  \pgfmathsetmacro{\kwlim}{3*#2+2}\kwtlim=\kwlim pt\relax
  \ifdim\kwh>\kwtav \kwbadtrue\else\ifdim\kwh>\kwtlim \kwbadtrue\else\kwbadfalse\fi\fi}
\newcommand{\kwtitlesize}[3]{\kwtav=#2\relax
  \kwtitletry{58}{60}{#1}{#3}%
  \ifkwbad\kwtitletry{44}{47}{#1}{#3}%
    \ifkwbad\def\kwts{36}\def\kwtl{38}\fi\fi}
\newcommand{\kwmetablk}[2]{\kwifempty{#1#2}{}{{\kwregular\kwsize{15}{20}\color{kwwhite}%
  \kwifempty{#1}{}{{\kwmedium #1}}\kwifempty{#1}{}{\kwifempty{#2}{}{\hspace{5mm}}}%
  \kwifempty{#2}{}{\color{kwgrey}#2}\par}}}
\newcommand{\kwsubblk}[1]{\kwifempty{#1}{}{{\kwlight\kwsize{26}{34}\color{kwgrey}\raggedright #1\par}}}
\newcommand{\kwtitleslide}[5]{\kwframe{kwdeepgreen}{}{kwgrey}{kwgreen}{%
  \kwseismo{238.67}{0}{100}%
  \kwimg{24}{24}{46}{kw-navnetrekk-hvit.pdf}%
  \kwmeasure{190}{\kwmetablk{#3}{#4}}\kwmh=\kwh
  \kwmeasure{196}{\kwsubblk{#2}}\kwsh=\kwh
  \kwavail=126.5mm \advance\kwavail by-\kwmh \advance\kwavail by-\kwsh
  \ifdim\kwmh>0pt \advance\kwavail by-14mm\fi \ifdim\kwsh>0pt \advance\kwavail by-9mm\fi
  \kwtitlesize{196}{\kwavail}{#1}%
  \kwatb{24}{166.5}{196}{\kwtitlebigs\kwts\kwtl{#1}%
    \ifdim\kwsh>0pt\vskip 9mm\kwsubblk{#2}\fi\ifdim\kwmh>0pt\vskip 14mm\kwmetablk{#3}{#4}\fi}%
  }{#5}}

% ---------- 2. Section divider ----------
\newcommand{\kwdivider}[4]{\kwframe{kwdeepgreen}{}{kwgrey}{kwgreen}{%
  \kwseismo{250.67}{78}{88}%
  \kwat{24}{24}{60}{{\kwmedium\addfontfeature{LetterSpace=5}\kwsize{16}{20}\color{kwgreen}#1}}%
  \kwrect{24}{33}{12}{0.5}{kwgreen}%
  \kwifempty{#3}{\kwsh=0pt}{\kwmeasure{150}{{\kwlight\kwsize{24}{32}\color{kwgrey}\raggedright #3\par}}\kwsh=\kwh}%
  \kwavail=92.5mm \advance\kwavail by-\kwsh
  \kwtitlesize{196}{\kwavail}{#2}%
  \kwat{24}{66}{196}{\kwtitlebigs\kwts\kwtl{#2}}%
  \kwifempty{#3}{}{\kwatb{24}{166.5}{150}{\kwlight\kwsize{24}{32}\color{kwgrey}\raggedright #3}}%
  }{#4}}

% ---------- 3. Content (title, optional lead, body) ----------
\newcommand{\kwlb}[2]{\kwbody\kwifempty{#1}{}{{\kwlead #1\par}\vskip\ifkwsmall 5mm\else 7mm\fi}#2\par}
\newcommand{\kwcontent}[4]{\kwframe{kwwhite}{kw-navnetrekk-svart.pdf}{kwmuted}{kwdarkgreen}{%
  \kwtab
  \kwat{24}{23}{250}{\kwtitle #1}%
  \gdef\kwcurtitle{#1}%
  \kwfitbody{24}{58}{196}{106}{\kwlb{#2}{#3}}{250}%
  }{#4}}

% ---------- 4. Image: text left, photo bleeding off top and right edge ----------
\newcommand{\kwimageslide}[5]{\kwframe{kwwhite}{kw-navnetrekk-svart.pdf}{kwmuted}{kwdarkgreen}{%
  \kwcover{176.67}{0}{162}{160}{#4}%
  \kwtab
  \kwat{24}{23}{136}{\kwtitle #1}%
  \gdef\kwcurtitle{#1}%
